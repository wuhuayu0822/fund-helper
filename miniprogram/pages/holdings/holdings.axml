<view class="page">
  <view class="card">
    <view class="section-title">{{editingCode ? '编辑持仓' : '添加持仓'}}</view>

    <view class="field">
      <text class="field-label">基金代码</text>
      <input
        class="field-input"
        type="number"
        placeholder="6位基金代码，如 000001"
        value="{{formCode}}"
        disabled="{{!!editingCode}}"
        onInput="onInputCode"
      />
    </view>

    <view class="field">
      <text class="field-label">持有份额</text>
      <input class="field-input" type="digit" placeholder="如 1000" value="{{formShares}}" onInput="onInputShares" />
    </view>

    <view class="field">
      <text class="field-label">持仓成本净值</text>
      <input class="field-input" type="digit" placeholder="如 1.2000" value="{{formCost}}" onInput="onInputCost" />
    </view>

    <view a:if="{{formError}}" class="form-error">{{formError}}</view>

    <view class="row form-actions">
      <view a:if="{{editingCode}}" class="btn-plain action-btn" onTap="cancelEdit">取消</view>
      <view class="btn-primary action-btn" onTap="handleSubmit">{{submitting ? '提交中...' : (editingCode ? '保存修改' : '查询并添加')}}</view>
    </view>
  </view>

  <view class="section-title list-title">已添加持仓</view>
  <view a:if="{{holdings.length === 0}}" class="card muted center-text">暂无持仓</view>

  <view class="card item-card" a:for="{{holdings}}" a:key="fundCode">
    <view class="row">
      <view class="item-name">{{item.fundName}}</view>
      <view class="row action-icons">
        <text class="link" data-code="{{item.fundCode}}" onTap="startEdit">编辑</text>
        <text class="link link-danger" data-code="{{item.fundCode}}" onTap="handleDelete">删除</text>
      </view>
    </view>
    <view class="muted small-row">代码 {{item.fundCode}} · 份额 {{item.shares}} · 成本净值 {{item.costNav}}</view>
  </view>

  <view class="btn-plain done-btn" onTap="goBack">完成，返回首页</view>
</view>

.page {
  padding-bottom: 40rpx;
}

.head-card {
  padding-bottom: 28rpx;
}

.fund-name {
  font-size: 32rpx;
  font-weight: 600;
}

.small {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.nav-row {
  justify-content: flex-start;
  margin: 12rpx 0;
}

.nav-value {
  font-size: 48rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.nav-change {
  font-size: 30rpx;
  font-weight: 600;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.chart {
  width: 690rpx;
  height: 340rpx;
}

.legend {
  justify-content: flex-start;
  margin-top: 12rpx;
}

.legend-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 22rpx;
  color: #8a8f99;
  margin-right: 32rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-blue {
  background: #1677ff;
}

.dot-orange {
  background: #e5a800;
}

.signal-card {
  border-left: 8rpx solid #6b7280;
}

.signal-card-buy {
  border-left-color: #e54d42;
  background: #fef6f6;
}

.signal-card-sell {
  border-left-color: #16a34a;
  background: #f3fbf6;
}

.signal-card-watch {
  border-left-color: #6b7280;
}

.signal-label {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.reason-item {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.7;
}

.stat-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.stat-item {
  width: 33%;
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #8a8f99;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.disclaimer {
  font-size: 22rpx;
  line-height: 1.6;
}

.center-text {
  text-align: center;
}
